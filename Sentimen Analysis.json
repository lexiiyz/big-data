        "jsCode": "const llmResult = JSON.parse($input.first().json.output);\nconst originalTweet = $('Find documents').item.json; \n\nreturn {\n  mongodb_id: originalTweet._id,\n  tweet_user: originalTweet.user,\n  tweet_text: originalTweet.text,\n  query_topic: llmResult.kategori_spesifik, \n  kategori_utama: llmResult.kategori_utama,\n  sentiment: llmResult.sentimen,\n  reason: llmResult.alasan,\n  tweet_posted_at: originalTweet.timestamp\n};"
