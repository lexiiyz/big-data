    {
      "parameters": {
        "jsCode": "// n8n Code Node — News Article Merging\n\n// Mengambil data AI (langsung sebagai objek, tanpa di-parse ulang)\nconst llmResult = $input.first().json.output || $input.first().json;\nconst originalArticle = $('Find documents').item.json;\n\n// Helper: konversi string ke integer, return null jika tidak valid\nfunction toIntOrNull(val) {\n  const n = parseInt(val);\n  return isNaN(n) ? null : n;\n}\n\n// Helper: normalisasi string kosong ke null\nfunction strOrNull(val) {\n  if (val === undefined || val === null) return null;\n  const s = String(val).trim();\n  return s.length > 0 ? s : null;\n}\n\nreturn {\n  // Referensi ke MongoDB\n  mongo_id: String(originalArticle._id),\n\n  // Identitas artikel\n  title:        originalArticle.title,\n  url:          originalArticle.url,\n  source:       originalArticle.source || 'Radar Semarang',\n\n  // Waktu\n  published_at: originalArticle.published_at || null,\n  scraped_at:   originalArticle.scraped_at   || null,\n  analyzed_at:  new Date().toISOString(),\n\n  // Hasil klasifikasi AI\n  kategori:     strOrNull(llmResult.kategori),\n  ringkasan:    strOrNull(llmResult.ringkasan),\n\n  // Lokasi (semua nullable)\n  provinsi:       strOrNull(llmResult.provinsi),\n  kabupaten_kota: strOrNull(llmResult.kabupaten_kota),\n  kecamatan:      strOrNull(llmResult.kecamatan),\n  kelurahan:      strOrNull(llmResult.kelurahan),\n  lokasi_detail:  strOrNull(llmResult.lokasi_detail),\n\n  // Metadata tambahan\n  korban_jiwa: toIntOrNull(llmResult.korban_jiwa),\n  korban_luka: toIntOrNull(llmResult.korban_luka),\n  severity:    strOrNull(llmResult.severity),\n};"
      },
